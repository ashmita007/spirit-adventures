# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# ---- Domain (point an A record for it and for www.<it> to the VPS IP first) ----
DOMAIN=spiritadventures.in
ACME_EMAIL=you@example.com

# ---- Django ----
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
GUNICORN_WORKERS=3

# ---- Database ----
POSTGRES_DB=spirit_adventures
POSTGRES_USER=spirit
POSTGRES_PASSWORD=change-me-strong-db-password
BACKUP_KEEP_DAYS=14

# ---- First owner login (created on first start if missing) ----
DJANGO_SUPERUSER_EMAIL=admin@spiritadventures.in
DJANGO_SUPERUSER_PASSWORD=change-me-owner-password
DJANGO_SUPERUSER_FIRST_NAME=Owner
DJANGO_SUPERUSER_LAST_NAME=Spirit

# Load the demo trips only into an EMPTY database (1 = yes). Existing trips are never touched.
SEED_DEMO_DATA=0

# ---- Cloudinary uploads (Cloudinary -> Settings -> API Keys) ----
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ---- Contact details ----
WHATSAPP_NUMBER=+919666567551
SUPPORT_EMAIL=info@spiritadventures.in
SUPPORT_PHONE=+91 96665 67551
NEXT_PUBLIC_WHATSAPP_NUMBER=+919666567551
NEXT_PUBLIC_PHONE_NUMBER=+91 96665 67551
NEXT_PUBLIC_EMAIL=info@spiritadventures.in
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
